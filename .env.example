# Application
RISK_ENGINE_ENVIRONMENT=development
RISK_ENGINE_LOG_LEVEL=INFO
RISK_ENGINE_OFFLINE_MODE=true

# Local paths and persistence
RISK_ENGINE_DATA_DIR=data
RISK_ENGINE_DATABASE_URL=sqlite:///data/runtime/risksignal.db

# Live source endpoints. These defaults do not require credentials.
RISK_ENGINE_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
RISK_ENGINE_BLUESKY_BASE_URL=https://public.api.bsky.app

# Optional future credentials must be supplied locally and never committed.
# RISK_ENGINE_NEWS_API_KEY=
