# Application
RISK_ENGINE_ENVIRONMENT=development
RISK_ENGINE_LOG_LEVEL=INFO
RISK_ENGINE_OFFLINE_MODE=true

# Local paths and persistence
RISK_ENGINE_DATA_DIR=data
RISK_ENGINE_DATABASE_URL=sqlite:///data/runtime/risksignal.db
RISK_ENGINE_REQUEST_TIMEOUT_SECONDS=10
RISK_ENGINE_MAX_TEXT_LENGTH=10000

# Live source endpoints. GDELT is unauthenticated; Bluesky search may require a token.
RISK_ENGINE_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
RISK_ENGINE_BLUESKY_BASE_URL=https://public.api.bsky.app
RISK_ENGINE_BLUESKY_BEARER_TOKEN=

# NLP execution. Deterministic mode requires no model download.
RISK_ENGINE_NLP_MODE=deterministic
RISK_ENGINE_SENTIMENT_MODEL_ID=ProsusAI/finbert
RISK_ENGINE_SENTIMENT_MODEL_REVISION=4556d13015211d73dccd3fdd39d39232506f3e43
RISK_ENGINE_EVENT_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RISK_ENGINE_EVENT_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RISK_ENGINE_MODEL_CACHE_DIR=.cache/huggingface

# Stress testing. A signal triggers only when its impact score exceeds this value.
RISK_ENGINE_STRESS_TRIGGER_THRESHOLD=7

# Optional credentials must be supplied locally and never committed.
# RISK_ENGINE_NEWS_API_KEY=
